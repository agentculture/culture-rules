# Copy to replica-set.env on each host and edit. One dedicated mongod per host.
# Never 27017: that port belongs to whatever else runs on the box.
MONGO_PORT=27018
# This host's tailnet/LAN address, as it appears in rs-config.json (host:port).
MONGO_BIND_IP=0.0.0.0
MONGO_REPLSET=culture-rules-rs
MONGO_IMAGE=mongo:8.0
# Directory holding keyfile, server.pem and ca.pem (see gen-certs.sh).
MONGO_SECRETS_DIR=/etc/culture-rules-mongo
MONGO_DATA_DIR=/var/lib/culture-rules-mongo
MONGO_CACHE_GB=1
