# Environment for the culture-rules API on a serving host (the process cloudflared forwards to).
# Copy to the host's API environment file (for example ~/.config/culture-rules/api.env).
# The three Access variables are set TOGETHER or not at all; a partial tuple is refused.
#
# The Access listener is loopback only: cloudflared reaches it, the LAN never does. The ingress
# the tunnel carries is `--service http://127.0.0.1:<port>`, the same port as below.
CULTURE_RULES_ACCESS_LISTEN=127.0.0.1:18765
# Public identifier of the Zero Trust team, not a secret: <team>.cloudflareaccess.com
CULTURE_RULES_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
# The Access application's AUD tag (operator copies it from the dashboard after setup).
CULTURE_RULES_ACCESS_AUD=<access-app-aud-tag>
# SSO roles: comma-separated identities (emails). Everyone else Access lets through is a viewer.
CULTURE_RULES_ADMINS=<operator-email>
# The engine node /health reports on: the name `culture-rules node run` heartbeats under. Set the
# same value in the node's environment (node run defaults --host to it). Unset: the short hostname.
CULTURE_RULES_NODE_NAME=<node-name>
