{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "machine.schema.json",
  "title": "Machine",
  "x-schema-version": "1.0",
  "type": "object",
  "description": "An enrolled machine: identity (mesh server name), address, platform, capabilities.",
  "properties": {
    "name": {
      "type": "string",
      "description": "Machine identity (the mesh server name)"
    },
    "address": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Network address; defaults to the tailnet name",
      "default": null
    },
    "platform": {
      "type": "string",
      "description": "e.g. linux-aarch64",
      "default": ""
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Capabilities offered, e.g. gpu",
      "default": []
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "store_member",
          "engine_node",
          "runner"
        ]
      },
      "description": "store_member | engine_node | runner",
      "default": []
    },
    "description": {
      "type": "string",
      "description": "Free text",
      "default": ""
    },
    "enabled": {
      "type": "boolean",
      "description": "Disabled machines receive no placements",
      "default": true
    },
    "install": {
      "anyOf": [
        {
          "$ref": "#/$defs/MachineInstall"
        },
        {
          "type": "null"
        }
      ],
      "description": "How the node here is installed (rollout); absent on records that predate it",
      "default": null
    },
    "schema_version": {
      "type": "string",
      "description": "Document schema version (MAJOR.MINOR)",
      "default": "1.0"
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": false,
  "$defs": {
    "MachineInstall": {
      "type": "object",
      "description": "How the node on this machine is installed; mirrors deploy/node/install.sh's flags.",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "install_sh",
            "shared_venv"
          ],
          "description": "install_sh | shared_venv (API and node in one venv)"
        },
        "node_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "install.sh --node-name; defaults to the machine name",
          "default": null
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Grant secret NAMES ([A-Z0-9_]+) passed as install.sh --secret; never values",
          "default": []
        },
        "gate_run_as": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "install.sh --gate-run-as: a 'sudo -n -u <user> ...' run-as prefix",
          "default": null
        },
        "extras": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "install.sh --extras (joined with ',')",
          "default": null
        },
        "wheelhouse": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "install.sh --wheelhouse (offline install dir)",
          "default": null
        },
        "python": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "install.sh --python (venv Python version)",
          "default": null
        },
        "events_host": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "install.sh --events-host",
          "default": null
        },
        "events_port": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "install.sh --events-port (1-65535)",
          "default": null
        },
        "ssh_target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "rollout upgrade's ssh/scp target (e.g. an ~/.ssh/config alias); defaults to the machine address, else its name",
          "default": null
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    }
  }
}
