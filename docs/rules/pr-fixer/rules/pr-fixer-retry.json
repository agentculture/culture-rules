{
  "action": {
    "idempotent": false,
    "kind": "noop",
    "name": "Queued: the place in line is the run's output",
    "only_at_chain_end": false,
    "params": {},
    "retry": null,
    "timeout_s": null
  },
  "concurrency_key": "pr-fixer:{trigger.data.repository}#{trigger.data.number}",
  "condition": {
    "args": [
      {
        "cmp": "==",
        "left": {
          "field": "data.workflow_id"
        },
        "op": "compare",
        "right": {
          "literal": "pr-fix"
        }
      },
      {
        "arg": {
          "field": "data.outputs.verdict"
        },
        "op": "exists"
      },
      {
        "arg": {
          "items": {
            "literal": [
              "pass",
              "no_gate"
            ]
          },
          "op": "in",
          "value": {
            "field": "data.outputs.verdict"
          }
        },
        "op": "not"
      },
      {
        "items": {
          "var": "fixer_repos"
        },
        "op": "in",
        "value": {
          "field": "data.repository"
        }
      },
      {
        "arg": {
          "items": {
            "var": "fixer_excluded_repos"
          },
          "op": "in",
          "value": {
            "field": "data.repository"
          }
        },
        "op": "not"
      }
    ],
    "op": "and"
  },
  "counts_toward_budget": false,
  "description": "#35 d30: fires when a pr-fix try ends with a gate verdict other than pass or no_gate, and puts the PR back in the fixer queue at the back as a retry, with the gate's instruction and the original task; the requests already waiting run first. Shares the PR's key (it continues the chain), not an attempt itself. When the PR has used its 3 attempts the queue refuses the retry and the run hands back once.",
  "enabled": false,
  "exclusive_group": null,
  "id": "pr-fixer-retry",
  "max_attempts": null,
  "may_after": [],
  "must_after": [],
  "name": "PR fixer: back in the queue after a try that did not pass",
  "on_failure": {
    "idempotent": false,
    "kind": "github.comment",
    "name": "Hand back with the run link (once per chain)",
    "only_at_chain_end": true,
    "params": {
      "actor": "github-app",
      "body": "PR fixer handed back ({{ run.error.code }}): {{ run.error.message }}",
      "number": "trigger.data.number",
      "repo": "trigger.data.repository",
      "status": true
    },
    "retry": null,
    "timeout_s": null
  },
  "placement": {
    "actor": null,
    "machine": "spark2",
    "requirement": null
  },
  "priority": 0,
  "resets_attempt_budget": false,
  "schema_version": "1.0",
  "supersedes": [],
  "trigger": {
    "kind": "event",
    "params": {
      "type": "rules.run.succeeded"
    }
  },
  "workflow": {
    "id": "queue-add",
    "inputs": {
      "base_sha": "trigger.data.outputs.base_sha",
      "clone_url": "trigger.data.outputs.clone_url",
      "head_branch": "trigger.data.outputs.head_branch",
      "head_sha": "trigger.data.head_sha",
      "instruction": "trigger.data.outputs.gate_instruction",
      "number": "trigger.data.number",
      "prior_instruction": "trigger.data.outputs.instruction",
      "repo": "trigger.data.repository",
      "retry": {
        "$literal": true
      },
      "task": "trigger.data.outputs.task"
    },
    "version": null
  }
}
