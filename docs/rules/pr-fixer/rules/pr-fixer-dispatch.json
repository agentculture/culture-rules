{
  "action": {
    "idempotent": false,
    "kind": "github.comment",
    "name": "Comment when the chain ends here",
    "only_at_chain_end": true,
    "params": {
      "actor": "github-app",
      "body": "PR fixer built and gated {{ workflow.outputs.commit_sha }} (gate {{ workflow.outputs.verdict }}) but nothing reviews it (pr-fixer-review-commit is disabled): not pushed.",
      "number": "trigger.data.number",
      "repo": "trigger.data.repository",
      "status": true
    },
    "retry": null,
    "timeout_s": null
  },
  "concurrency_key": "pr-fixer:{trigger.data.repository}#{trigger.data.number}",
  "condition": {
    "args": [
      {
        "cmp": "==",
        "left": {
          "field": "data.queue"
        },
        "op": "compare",
        "right": {
          "literal": "pr-fixer"
        }
      },
      {
        "items": {
          "var": "fixer_repos"
        },
        "op": "in",
        "value": {
          "field": "data.repository"
        }
      },
      {
        "arg": {
          "items": {
            "var": "fixer_excluded_repos"
          },
          "op": "in",
          "value": {
            "field": "data.repository"
          }
        },
        "op": "not"
      }
    ],
    "op": "and"
  },
  "counts_toward_budget": true,
  "description": "#35 d29: fires on the fixer queue's rules.queue.dispatch event (written only by the queue.progress built-in, never from outside) and runs pr-fix with the request's inputs: one try per run (d30). A fix attempt: counts toward the PR's attempt budget (3) on the per-PR concurrency key. Repos in vars.fixer_repos only; vars.fixer_excluded_repos overrides it.",
  "enabled": false,
  "exclusive_group": null,
  "id": "pr-fixer-dispatch",
  "max_attempts": 3,
  "may_after": [],
  "must_after": [],
  "name": "PR fixer: start the fix at the head of the queue",
  "on_failure": {
    "idempotent": false,
    "kind": "github.comment",
    "name": "Hand back with the run link (once per chain)",
    "only_at_chain_end": true,
    "params": {
      "actor": "github-app",
      "body": "PR fixer handed back ({{ run.error.code }}): {{ run.error.message }}",
      "number": "trigger.data.number",
      "repo": "trigger.data.repository",
      "status": true
    },
    "retry": null,
    "timeout_s": null
  },
  "placement": {
    "actor": null,
    "machine": "spark2",
    "requirement": null
  },
  "priority": 0,
  "resets_attempt_budget": false,
  "schema_version": "1.0",
  "supersedes": [],
  "trigger": {
    "kind": "event",
    "params": {
      "type": "rules.queue.dispatch"
    }
  },
  "workflow": {
    "id": "pr-fix",
    "inputs": {
      "base_sha": "trigger.data.base_sha",
      "clone_url": "trigger.data.clone_url",
      "head_branch": "trigger.data.head_branch",
      "head_sha": "trigger.data.head_sha",
      "instruction": "trigger.data.instruction",
      "number": "trigger.data.number",
      "repo": "trigger.data.repository",
      "task": "trigger.data.task",
      "trusted_authors": {
        "$var": "trusted_authors"
      }
    },
    "version": null
  }
}
