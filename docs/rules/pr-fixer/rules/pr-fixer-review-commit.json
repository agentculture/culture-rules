{
  "action": {
    "idempotent": false,
    "kind": "github.comment",
    "name": "Comment when the chain ends here (review-only mode)",
    "only_at_chain_end": true,
    "params": {
      "actor": "github-app",
      "body": "PR fixer review: {{ workflow.outputs.review }} for {{ workflow.outputs.commit_sha }} (gate {{ workflow.outputs.verdict }}); not pushed: nothing publishes it (review-only mode, or the repository has no test gate).\n\n{{ workflow.outputs.summary }}\n\nRun: https://rules.culture.dev/api/runs/{{ run.id }}",
      "number": "trigger.data.number",
      "repo": "trigger.data.repository",
      "status": true
    },
    "retry": null,
    "timeout_s": null
  },
  "concurrency_key": "pr-fixer:{trigger.data.repository}#{trigger.data.number}",
  "condition": {
    "args": [
      {
        "cmp": "==",
        "left": {
          "field": "data.workflow_id"
        },
        "op": "compare",
        "right": {
          "literal": "pr-fix"
        }
      },
      {
        "items": {
          "literal": [
            "pass",
            "no_gate"
          ]
        },
        "op": "in",
        "value": {
          "field": "data.outputs.verdict"
        }
      },
      {
        "items": {
          "var": "fixer_repos"
        },
        "op": "in",
        "value": {
          "field": "data.repository"
        }
      },
      {
        "arg": {
          "items": {
            "var": "fixer_excluded_repos"
          },
          "op": "in",
          "value": {
            "field": "data.repository"
          }
        },
        "op": "not"
      }
    ],
    "op": "and"
  },
  "counts_toward_budget": false,
  "description": "d21: fires when a pr-fix run succeeds (its gate passed or the repo has no gate) and has its gated commit reviewed by codex-reviewer. Not a fix attempt: outside the attempt budget, on the PR's key, which the chain holds between its stages.",
  "enabled": false,
  "exclusive_group": null,
  "id": "pr-fixer-review-commit",
  "max_attempts": null,
  "may_after": [],
  "must_after": [],
  "name": "PR fixer: review the fix",
  "on_failure": {
    "idempotent": false,
    "kind": "github.comment",
    "name": "Hand back with the run link (once per chain)",
    "only_at_chain_end": true,
    "params": {
      "actor": "github-app",
      "body": "PR fixer handed back ({{ run.error.code }}): {{ run.error.message }}\n\nRun: https://rules.culture.dev/api/runs/{{ run.id }}",
      "number": "trigger.data.number",
      "repo": "trigger.data.repository",
      "status": true
    },
    "retry": null,
    "timeout_s": null
  },
  "placement": {
    "actor": null,
    "machine": "spark2",
    "requirement": null
  },
  "priority": 0,
  "schema_version": "1.0",
  "supersedes": [],
  "trigger": {
    "kind": "event",
    "params": {
      "type": "rules.run.succeeded"
    }
  },
  "workflow": {
    "id": "review-commit",
    "inputs": {
      "base_sha": "trigger.data.outputs.base_sha",
      "bundle": "trigger.data.outputs.bundle",
      "clone_url": "trigger.data.outputs.clone_url",
      "commit_sha": "trigger.data.outputs.commit_sha",
      "diff": "trigger.data.outputs.diff",
      "diff_truncated": "trigger.data.outputs.diff_truncated",
      "gate_output": "trigger.data.outputs.gate_output",
      "gate_verdict": "trigger.data.outputs.verdict",
      "head_branch": "trigger.data.outputs.head_branch",
      "head_sha": "trigger.data.outputs.start_sha",
      "number": "trigger.data.number",
      "pr_intent": "trigger.data.outputs.instruction",
      "repo": "trigger.data.repository",
      "threads": "trigger.data.outputs.threads",
      "threads_addressed": "trigger.data.outputs.threads_addressed"
    },
    "version": null
  }
}
