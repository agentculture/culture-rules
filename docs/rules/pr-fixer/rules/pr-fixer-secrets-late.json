{
  "action": {
    "idempotent": false,
    "kind": "github.comment",
    "name": "Comment the findings",
    "only_at_chain_end": false,
    "params": {
      "actor": "github-app",
      "body": "{{ workflow.outputs.comment }}\n\nRun: https://rules.culture.dev/api/runs/{{ run.id }}",
      "number": "trigger.data.number",
      "once_key": "gitguardian:{{ trigger.data.repository }}#{{ trigger.data.number }}@{{ trigger.data.head_sha }}",
      "repo": "trigger.data.repository"
    },
    "retry": null,
    "timeout_s": null
  },
  "concurrency_key": "pr-secrets:{trigger.data.repository}#{trigger.data.number}@{trigger.data.head_sha}",
  "condition": {
    "args": [
      {
        "cmp": "==",
        "left": {
          "field": "data.head_repo"
        },
        "op": "compare",
        "right": {
          "field": "data.base_repo"
        }
      },
      {
        "cmp": "==",
        "left": {
          "field": "data.state"
        },
        "op": "compare",
        "right": {
          "literal": "open"
        }
      },
      {
        "items": {
          "var": "fixer_repos"
        },
        "op": "in",
        "value": {
          "field": "data.repository"
        }
      },
      {
        "arg": {
          "items": {
            "var": "fixer_excluded_repos"
          },
          "op": "in",
          "value": {
            "field": "data.repository"
          }
        },
        "op": "not"
      },
      {
        "items": {
          "field": "data.failed_apps"
        },
        "op": "in",
        "value": {
          "literal": "gitguardian"
        }
      }
    ],
    "op": "and"
  },
  "counts_toward_budget": true,
  "description": "d25: the pr-fixer-secrets report for a GitGuardian failure that completes after its head SHA's checks settled (the settle timed out while GitGuardian ran, or a re-run failed): the settler emits github.pr.checks_failed_late once per head and app. Same condition, workflow, key and once_key as pr-fixer-secrets, so a head is commented once whichever fires.",
  "enabled": false,
  "exclusive_group": null,
  "id": "pr-fixer-secrets-late",
  "max_attempts": null,
  "may_after": [],
  "must_after": [],
  "name": "PR fixer: GitGuardian findings (late)",
  "on_failure": {
    "idempotent": false,
    "kind": "github.comment",
    "name": "Say the findings could not be read",
    "only_at_chain_end": false,
    "params": {
      "actor": "github-app",
      "body": "GitGuardian fails on {{ trigger.data.head_sha }}, but its findings could not be read ({{ run.error.code }}): open the GitGuardian check on this PR. Revoke and rotate each leaked secret, then remove it from the code; rewriting history does not un-leak it. The PR fixer does not touch secrets and stays off this PR until GitGuardian passes.\n\nRun: https://rules.culture.dev/api/runs/{{ run.id }}",
      "number": "trigger.data.number",
      "once_key": "gitguardian-unreadable:{{ trigger.data.repository }}#{{ trigger.data.number }}@{{ trigger.data.head_sha }}",
      "repo": "trigger.data.repository"
    },
    "retry": null,
    "timeout_s": null
  },
  "placement": {
    "actor": null,
    "machine": "spark2",
    "requirement": null
  },
  "priority": 0,
  "schema_version": "1.0",
  "supersedes": [],
  "trigger": {
    "kind": "event",
    "params": {
      "type": "github.pr.checks_failed_late"
    }
  },
  "workflow": {
    "id": "report-secrets",
    "inputs": {
      "head_sha": "trigger.data.head_sha",
      "repo": "trigger.data.repository"
    },
    "version": null
  }
}
