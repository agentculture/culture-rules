{
  "action": {
    "idempotent": false,
    "kind": "noop",
    "name": "Stopped: the run's output says what",
    "only_at_chain_end": false,
    "params": {},
    "retry": null,
    "timeout_s": null
  },
  "concurrency_key": null,
  "condition": {
    "args": [
      {
        "items": {
          "var": "fixer_repos"
        },
        "op": "in",
        "value": {
          "field": "data.repository"
        }
      },
      {
        "arg": {
          "items": {
            "var": "fixer_excluded_repos"
          },
          "op": "in",
          "value": {
            "field": "data.repository"
          }
        },
        "op": "not"
      },
      {
        "items": {
          "var": "trusted_authors"
        },
        "op": "in",
        "value": {
          "field": "data.author"
        }
      },
      {
        "arg": {
          "cmp": "==",
          "left": {
            "field": "data.self_authored"
          },
          "op": "compare",
          "right": {
            "literal": true
          }
        },
        "op": "not"
      },
      {
        "args": [
          {
            "items": {
              "var": "fixer_stop_triggers"
            },
            "op": "in",
            "value": {
              "field": "data.command"
            }
          },
          {
            "items": {
              "var": "fixer_stop_triggers"
            },
            "op": "in",
            "value": {
              "field": "data.mention_command"
            }
          }
        ],
        "op": "or"
      }
    ],
    "op": "and"
  },
  "counts_toward_budget": true,
  "description": "#40 d34: fires on a PR comment by an author in vars.trusted_authors (never the App itself) whose body starts with a form in vars.fixer_stop_triggers (default /stop and @rules-culture-dev stop). Repos in vars.fixer_repos only; vars.fixer_excluded_repos overrides it. Runs queue-stop: the PR's fixer story ends - its running fix run is cancelled (no push, no hand-back), its queued request and retries are removed and its status comment says who stopped it. No concurrency key, so it never waits behind the fix chain it stops. A new /fix or a push to the PR starts a new story.",
  "enabled": false,
  "exclusive_group": null,
  "id": "pr-fixer-stop",
  "max_attempts": null,
  "may_after": [],
  "must_after": [],
  "name": "PR fixer: stop on /stop",
  "on_failure": {
    "idempotent": false,
    "kind": "github.comment",
    "name": "Say the stop failed (once per chain)",
    "only_at_chain_end": true,
    "params": {
      "actor": "github-app",
      "body": "PR fixer stop failed ({{ run.error.code }}): {{ run.error.message }}",
      "number": "trigger.data.number",
      "repo": "trigger.data.repository"
    },
    "retry": null,
    "timeout_s": null
  },
  "placement": {
    "actor": null,
    "machine": "spark2",
    "requirement": null
  },
  "priority": 0,
  "resets_attempt_budget": false,
  "schema_version": "1.0",
  "supersedes": [],
  "trigger": {
    "kind": "event",
    "params": {
      "type": "github.comment.created"
    }
  },
  "workflow": {
    "id": "queue-stop",
    "inputs": {
      "by": "trigger.data.author",
      "head_sha": "trigger.data.head_sha",
      "number": "trigger.data.number",
      "repo": "trigger.data.repository"
    },
    "version": null
  }
}
