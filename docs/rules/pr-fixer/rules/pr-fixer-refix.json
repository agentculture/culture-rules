{
  "action": {
    "idempotent": false,
    "kind": "noop",
    "name": "Queued: the place in line is the run's output",
    "only_at_chain_end": false,
    "params": {},
    "retry": null,
    "timeout_s": null
  },
  "concurrency_key": "pr-fixer:{trigger.data.repository}#{trigger.data.number}",
  "condition": {
    "args": [
      {
        "cmp": "==",
        "left": {
          "field": "data.workflow_id"
        },
        "op": "compare",
        "right": {
          "literal": "review-commit"
        }
      },
      {
        "cmp": "==",
        "left": {
          "field": "data.outputs.review"
        },
        "op": "compare",
        "right": {
          "literal": "request_changes"
        }
      },
      {
        "items": {
          "var": "fixer_repos"
        },
        "op": "in",
        "value": {
          "field": "data.repository"
        }
      },
      {
        "arg": {
          "items": {
            "var": "fixer_excluded_repos"
          },
          "op": "in",
          "value": {
            "field": "data.repository"
          }
        },
        "op": "not"
      }
    ],
    "op": "and"
  },
  "counts_toward_budget": false,
  "description": "d21, #35 d30: fires when the review of a fix requests changes and puts the PR back in the fixer queue at the back as a retry from the same PR head, with the findings as the instruction. The dispatched pr-fix run is the attempt (it counts toward the PR's budget of 3); when the PR has used them the queue refuses the retry and the run hands back once.",
  "enabled": false,
  "exclusive_group": null,
  "id": "pr-fixer-refix",
  "max_attempts": null,
  "may_after": [],
  "must_after": [],
  "name": "PR fixer: fix again with the review's findings",
  "on_failure": {
    "idempotent": false,
    "kind": "github.comment",
    "name": "Hand back with the run link (once per chain)",
    "only_at_chain_end": true,
    "params": {
      "actor": "github-app",
      "body": "PR fixer handed back ({{ run.error.code }}): {{ run.error.message }}",
      "number": "trigger.data.number",
      "repo": "trigger.data.repository",
      "status": true
    },
    "retry": null,
    "timeout_s": null
  },
  "placement": {
    "actor": null,
    "machine": "spark2",
    "requirement": null
  },
  "priority": 0,
  "resets_attempt_budget": false,
  "schema_version": "1.0",
  "supersedes": [],
  "trigger": {
    "kind": "event",
    "params": {
      "type": "rules.run.succeeded"
    }
  },
  "workflow": {
    "id": "queue-add",
    "inputs": {
      "base_sha": "trigger.data.outputs.base_sha",
      "clone_url": "trigger.data.outputs.clone_url",
      "head_branch": "trigger.data.outputs.head_branch",
      "head_sha": "trigger.data.outputs.start_sha",
      "instruction": "trigger.data.outputs.instruction",
      "number": "trigger.data.number",
      "repo": "trigger.data.repository",
      "retry": {
        "$literal": true
      },
      "task": "trigger.data.outputs.task"
    },
    "version": null
  }
}
