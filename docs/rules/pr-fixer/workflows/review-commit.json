  "schema_version": "1.0",
  "steps": [
    {
      "body": [],
      "config": {
        "sandbox": "read-only",
        "when": {
          "args": [
            {
              "items": {
                "literal": [
                  "pass",
                  "no_gate"
                ]
              },
              "op": "in",
              "value": {
                "field": "gate_verdict"
              }
            },
            {
              "cmp": "==",
              "left": {
                "field": "diff_truncated"
              },
              "op": "compare",
              "right": {
                "literal": false
              }
            }
          ],
          "op": "and"
        }
      },
      "description": "d20: an independent reviewer (Codex through the codex bridge on spark, sandbox read-only) reviews the pr-fix run's gated commit's diff and ends with a verdict object. Its brief is locked in the codex-reviewer actor (trusted code), never this workflow. Runs only for a passing gate (or no gate) whose diff is complete text; never commits or pushes.",
      "enabled": true,
      "id": "review",
      "inputs": [
        {
          "description": "clone URL (the bridge checks out the PR head)",
          "name": "repo",
          "required": true,
          "type": "string"
        },
        {
          "description": "",
          "name": "head_branch",
          "required": true,
          "type": "string"
        },
        {
          "description": "the PR head the fix starts from (gate start_sha)",
          "name": "head_sha",
          "required": true,
          "type": "string"
        },
        {
          "description": "the commit under review",
          "name": "commit_sha",
          "required": false,
          "type": "string"
        },
        {
          "description": "",
          "name": "diff",
          "required": false,
          "type": "string"
        },
        {
          "description": "",
          "name": "diff_truncated",
          "required": false,
          "type": "boolean"
        },
        {
          "description": "",
          "name": "gate_verdict",
          "required": false,
          "type": "string"
        },
        {
          "description": "",
          "name": "gate_output",
          "required": false,
          "type": "string"
        },
        {
          "description": "the fixer's original task",
          "name": "pr_intent",
          "required": false,
          "type": "string"
        },
        {
          "description": "the trusted, unresolved threads",
          "name": "threads",
          "required": false,
          "type": "array"
        }
      ],
      "kind": "ai",
      "max_iterations": null,
      "name": "Review the fix (independent agent, read-only)",
      "outputs": [
        {
          "description": "the verdict object, as a JSON string",
          "name": "summary",
          "required": false,
          "type": "string"
        },
        {
          "description": "",
          "name": "status",
          "required": false,
          "type": "string"
        },
        {
          "description": "",
