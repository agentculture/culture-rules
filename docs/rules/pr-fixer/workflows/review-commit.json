          "required": false,
          "type": "string"
        },
        {
          "description": "",
          "name": "head_after",
          "required": false,
          "type": "string"
        },
        {
          "description": "",
          "name": "commits",
          "required": false,
          "type": "array"
        },
        {
          "description": "",
          "name": "dirty",
          "required": false,
          "type": "boolean"
        }
      ],
      "placement": {
        "actor": "codex-reviewer",
        "machine": null,
        "requirement": null
      },
      "retry": null,
      "timeout_s": 1800.0
    },
    {
      "body": [],
      "config": {
        "builtin": "review"
      },
      "description": "Walks to the pr-fix run whose success started this run (verified run-event lineage, from the store, never wired inputs), reads its last gate and implementer and this run's reviewer, checks the reviewer was read-only, saw exactly that commit's diff and is not the implementer, parses the verdict fail-closed and records it for that commit (repo, PR, base, start, tip), where github.push finds it. request_changes becomes the re-fix's instruction; with the attempt budget spent it fails the run (changes_requested).",
      "enabled": true,
      "id": "verdict",
      "inputs": [
        {
          "description": "the review step (ordering only)",
          "name": "after",
          "required": false,
          "type": "any"
        }
      ],
      "kind": "code",
      "max_iterations": null,
      "name": "Review verdict",
      "outputs": [
        {
          "description": "the gate's verdict",
          "name": "verdict",
          "required": true,
          "type": "string"
        },
        {
          "description": "approve, request_changes or not_run",
          "name": "review",
          "required": true,
          "type": "string"
        },
        {
          "description": "",
          "name": "findings",
          "required": false,
          "type": "array"
        },
        {
