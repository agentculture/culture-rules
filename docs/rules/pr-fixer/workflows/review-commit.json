          "required": false,
          "type": "string"
        },
        {
          "description": "",
          "name": "base_sha",
          "required": false,
          "type": "string"
        },
        {
          "description": "one line per finding",
          "name": "summary",
          "required": false,
          "type": "string"
        }
      ],
      "placement": null,
      "retry": null,
      "timeout_s": 60.0
    }
