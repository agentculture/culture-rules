    {
      "source": "inputs",
      "source_port": "repo",
      "target": "stop",
      "target_port": "repo"
    },
    {
      "source": "inputs",
      "source_port": "number",
      "target": "stop",
      "target_port": "number"
    },
    {
      "source": "inputs",
      "source_port": "by",
      "target": "stop",
      "target_port": "by"
    },
    {
      "source": "inputs",
      "source_port": "head_sha",
      "target": "stop",
      "target_port": "head_sha"
    },
    {
      "source": "stop",
      "source_port": "key",
      "target": "settle",
      "target_port": "after"
    },
    {
      "source": "inputs",
      "source_port": "repo",
      "target": "sweep",
      "target_port": "repo"
    },
    {
      "source": "inputs",
      "source_port": "number",
      "target": "sweep",
      "target_port": "number"
    },
    {
      "source": "settle",
      "source_port": "done",
      "target": "sweep",
