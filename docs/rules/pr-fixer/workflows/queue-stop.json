      "type": "string"
    },
    {
      "description": "",
      "name": "number",
      "required": false,
      "type": "integer"
    },
    {
      "description": "the trusted login that asked to stop",
      "name": "by",
      "required": false,
      "type": "string"
    },
    {
      "description": "the PR head the story is stopped at (the PR is read again)",
      "name": "head_sha",
