{
  "description": "d25: the GitGuardian findings of a PR head as one comment: each finding's secret type, file and line, commit and incident, never a secret value. A failed GitGuardian check is never auto-fixed.",
  "edges": [
    {
      "source": "inputs",
      "source_port": "repo",
      "target": "findings",
      "target_port": "repo"
    },
    {
      "source": "inputs",
      "source_port": "head_sha",
      "target": "findings",
      "target_port": "head_sha"
    }
  ],
  "enabled": true,
  "id": "report-secrets",
  "inputs": [
    {
      "description": "owner/name",
      "name": "repo",
      "required": false,
      "type": "string"
    },
    {
      "description": "the PR head GitGuardian scanned",
      "name": "head_sha",
      "required": false,
      "type": "string"
    }
  ],
  "name": "Report GitGuardian findings",
  "outputs": [
    {
      "name": "comment",
