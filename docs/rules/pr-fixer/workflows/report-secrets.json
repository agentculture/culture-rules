          "required": true,
          "type": "string"
        },
        {
          "description": "",
          "name": "findings",
          "required": true,
          "type": "array"
        },
        {
          "description": "",
          "name": "total",
          "required": false,
          "type": "integer"
        },
        {
          "description": "",
