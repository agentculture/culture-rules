      "type": "string"
    },
    {
      "name": "total",
      "source": "steps.findings.outputs.total",
      "type": "integer"
    },
    {
      "name": "findings",
      "source": "steps.findings.outputs.findings",
      "type": "array"
    }
  ],
  "schema_version": "1.0",
  "steps": [
    {
      "body": [],
