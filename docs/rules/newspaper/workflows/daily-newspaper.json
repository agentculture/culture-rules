  "name": "Daily newspaper",
  "notes": "#53: one dated issue a day. Parse the sections, claim the local date (a date already delivered ends the run with nothing sent), search and filter each section, summarise it with cortex until the summary window closes (a failed or late summary leaves the results-only rendering), render the HTML and the EPUB, then deliver behind lease fences: the email (once per date, with a durable per-date key and the first rendered payload), the queue on the Xteink reader, the delivery record. Non-agentic: no bridge actor, no agent step.",
  "outputs": [
    {
      "name": "message_id",
      "source": "steps.push_gate.outputs.message_id",
      "type": "string"
    },
    {
      "name": "item_id",
      "source": "steps.record.outputs.item_id",
      "type": "any"
    },
    {
      "name": "date",
      "source": "steps.claim.outputs.date",
      "type": "string"
    },
    {
      "name": "email_uncertain",
      "source": "steps.push_gate.outputs.email_uncertain",
      "type": "boolean"
    },
    {
      "name": "email_sent",
      "source": "steps.push_gate.outputs.email_sent",
      "type": "boolean"
    },
    {
      "name": "no_recipients",
      "source": "steps.push_gate.outputs.no_recipients",
      "type": "boolean"
    }
  ],
