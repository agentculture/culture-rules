      "description": "the finished run's window count",
      "name": "window_count",
      "required": true,
      "type": "integer"
    },
    {
      "description": "how many of those windows came back empty",
      "name": "empty_window_count",
      "required": true,
      "type": "integer"
    }
  ],
  "name": "Put a transcript on the reader",
  "notes": "One book per recording, after its transcription finishes (fired by the transcription run's rules.run.succeeded, rule pocket-to-reader). An en recording whose whisper windows were all empty is first transcribed again on stt-he (fallback; keep and pick choose the transcript). Then a 1-2 line summary on cortex-spark2 that reads the transcript itself (d2), the EPUB, and the push to the reader. Outputs carry no transcript or summary text.",
  "outputs": [
    {
      "name": "title",
      "source": "steps.render.outputs.title",
      "type": "string"
    },
    {
      "name": "date",
      "source": "steps.render.outputs.date",
      "type": "string"
    },
    {
      "name": "word",
      "source": "steps.render.outputs.word",
      "type": "string"
    },
    {
      "name": "summary_used",
      "source": "steps.render.outputs.summary_used",
      "type": "boolean"
    },
    {
      "name": "source",
      "source": "steps.pick.outputs.source",
      "type": "string"
    },
    {
      "name": "item_id",
      "source": "steps.push.outputs.item_id",
      "type": "integer"
    },
    {
      "name": "created",
      "source": "steps.push.outputs.created",
      "type": "boolean"
    },
    {
      "name": "audio_sha256",
      "source": "inputs.audio_sha256",
      "type": "string"
    }
  ],
  "schema_version": "1.0",
  "steps": [
    {
      "body": [],
      "config": {
        "action": {
          "kind": "audio.transcribe",
          "params": {
            "actor": "stt-he",
            "audio_path": "inputs.audio_path",
            "audio_sha256": "inputs.audio_sha256",
            "language": "inputs.language",
            "output_dir": "inputs.output_dir"
          }
        },
        "builtin": "action",
        "idempotent": true,
        "when": {
          "args": [
            {
              "cmp": "==",
              "left": {
                "field": "language"
              },
              "op": "compare",
              "right": {
                "literal": "en"
              }
            },
            {
              "cmp": "==",
              "left": {
                "field": "empty_window_count"
              },
              "op": "compare",
              "right": {
                "field": "window_count"
              }
            }
          ],
          "op": "and"
        }
      },
      "description": "",
      "enabled": true,
      "id": "fallback",
      "inputs": [
        {
          "description": "",
          "name": "audio_path",
          "required": true,
          "type": "string"
        },
        {
          "description": "",
          "name": "audio_sha256",
          "required": true,
          "type": "string"
        },
        {
          "description": "",
          "name": "output_dir",
          "required": true,
          "type": "string"
        },
        {
          "description": "",
          "name": "language",
          "required": false,
          "type": "string"
        },
        {
          "description": "",
          "name": "window_count",
          "required": true,
          "type": "integer"
        },
        {
          "description": "",
          "name": "empty_window_count",
          "required": true,
          "type": "integer"
        }
      ],
      "kind": "code",
      "max_iterations": null,
      "name": "Transcribe again in Hebrew",
      "notes": "q1: only for an en recording whose whisper windows all came back empty (empty_window_count == window_count): audio.transcribe through stt-he writes the zipformer transcript beside whisper's, and the book uses it. Otherwise skipped.",
      "outputs": [
        {
          "description": "the zipformer transcript's absolute path",
          "name": "result_path",
          "required": true,
          "type": "string"
        }
      ],
      "placement": null,
      "retry": {
        "backoff_multiplier": 2.0,
        "backoff_s": 60.0,
        "max_attempts": 3
      },
      "timeout_s": 14400.0
    },
    {
      "body": [],
      "config": {
        "builtin": "select",
        "ports": [
          "result_path"
        ],
        "sources": {
          "given": "given"
        },
        "when": {
          "arg": {
            "args": [
              {
                "cmp": "==",
                "left": {
                  "field": "language"
                },
                "op": "compare",
                "right": {
                  "literal": "en"
                }
              },
              {
                "cmp": "==",
                "left": {
                  "field": "empty_window_count"
                },
                "op": "compare",
                "right": {
                  "field": "window_count"
                }
              }
            ],
            "op": "and"
          },
          "op": "not"
        }
      },
      "description": "",
