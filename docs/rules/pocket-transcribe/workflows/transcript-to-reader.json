          }
        },
        "builtin": "action",
        "idempotent": true,
        "on_error": "skip"
      },
      "description": "",
      "enabled": true,
      "id": "summary",
      "inputs": [
        {
          "description": "",
          "name": "result_path",
          "required": true,
          "type": "string"
        },
