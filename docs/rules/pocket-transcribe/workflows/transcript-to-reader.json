          "required": true,
          "type": "string"
        }
      ],
      "kind": "code",
      "max_iterations": null,
      "name": "Summarise the recording",
      "notes": "llm.complete on cortex-spark2 with the locked transcript brief: it reads the first 48000 characters of the transcript itself (content_path, d2), so the transcript text never enters the run; the reply is JSON {summary, word}. on_error skip: the book still ships, titled <date> recording, with \"Summary unavailable.\".",
      "outputs": [
